# ============================================================
# Projeto Sentinela — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# O arquivo .env.local NUNCA deve ser commitado no git.
# ============================================================

# --- Supabase ---
# Encontre em: painel Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- MQTT (broker próprio, somente leitura anônima; sem usuário/senha no frontend) ---
# Protocolo WebSocket seguro: wss://
VITE_MQTT_BROKER_URL=wss://mqtt.arthlabs.dev/mqtt

# --- Dev local com Supabase/broker locais (opcional; só o `npm run dev` usa) ---
# O Vite repassa /auth, /rest, /storage, /functions, /realtime e /mqtt, e o
# navegador só precisa da porta 5173. Com isto ligado, use:
#   VITE_SUPABASE_URL=http://localhost:5173
#   VITE_MQTT_BROKER_URL=ws://localhost:5173/mqtt
# DEV_SUPABASE_PROXY=http://localhost:8000
# DEV_MQTT_PROXY=ws://localhost:9001

# --- Mapa (opcional) ---
# Key gratuita do CARTO Basemaps (sem conta, só e-mail): https://carto.com/basemaps/apikey
# Com ela o mapa usa o estilo Dark Matter; sem ela cai no Esri World Dark Gray.
# A key vai para o bundle público — restrinja-a ao domínio do site no painel do CARTO.
VITE_CARTO_BASEMAPS_KEY=
