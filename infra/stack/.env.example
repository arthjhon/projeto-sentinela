# Copiar para .env e preencher. Nunca versionar valores.
# Token admin do InfluxDB (bootstrap inicial)
INFLUX_ADMIN_TOKEN=
# Senha do usuario admin do InfluxDB
INFLUX_ADMIN_PASSWORD=
# Token de escrita no bucket iot, usado pelo Telegraf
INFLUX_TELEGRAF_TOKEN=
# Token de leitura/escrita usado pelo worker
INFLUX_WORKER_TOKEN=
# URL completa do broker MQTT com esquema e porta (ex.: ssl://<host>:8883)
MQTT_BROKER=
# Usuario MQTT do Telegraf (somente subscribe)
MQTT_TELEGRAF_USER=
# Senha MQTT do Telegraf
MQTT_TELEGRAF_PASS=
# DSN Postgres do worker (Supabase)
PG_WORKER_DSN=
# Nome da rede docker externa do Supabase
SUPABASE_NETWORK=
