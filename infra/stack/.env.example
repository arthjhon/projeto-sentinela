# Copiar para .env e preencher. Nunca versionar valores.
# Token admin do InfluxDB (bootstrap inicial)
INFLUX_ADMIN_TOKEN=
# Senha do usuario admin do InfluxDB
INFLUX_ADMIN_PASSWORD=
# Token de escrita no bucket iot, usado pelo Telegraf
INFLUX_TELEGRAF_TOKEN=
# Token de leitura/escrita usado pelo worker (buckets externos, qualidade, iot)
INFLUX_WORKER_TOKEN=
# URL do broker MQTT: o mosquitto do proprio compose (listener 1883, rede interna)
MQTT_BROKER=tcp://mosquitto:1883
# Usuario MQTT do Telegraf (somente subscribe; ver infra/stack/mosquitto/acl)
MQTT_TELEGRAF_USER=svc/telegraf
# Senha MQTT do Telegraf (a mesma gravada no passwd do broker; runbook "Broker MQTT")
MQTT_TELEGRAF_PASS=
# DSN Postgres do worker (Supabase): gravado pelo passo 9 do runbook (infra/README.md),
# host supabase-db, role sentinela_worker. Nunca editar a senha a mao aqui.
PG_WORKER_DSN=
# Rede docker externa do worker: a rede interna dedicada em que so o supabase-db entra
# (runbook, passo 7). Nunca supabase_default (postgres-meta la executa SQL sem auth).
SUPABASE_NETWORK=sentinela-pg
# Tokens Influx: ate o influx-bootstrap.sh (passo 12), placeholders NAO vazios
# (ex.: pendente-bootstrap); o compose exige as variaveis e os jobs so falham com 401.
# WORKER_TAG nao vai aqui: o stack-deploy.sh sempre exporta a tag (argumento ou a implantada).
